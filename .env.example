# Required executables (set one of each pair)
REINVENT4_BIN=reinvent
# REINVENT4_ROOT=../REINVENT4

BOLTZ_BIN=boltz
# BOLTZ_ROOT=../boltz

# Optional Python executable for wrappers/runner
PYTHON=python

# Optional assets root (repo-relative recommended)
DUALDOCK_ASSETS_ROOT=assets

# Optional target templates (repo-relative)
DUALDOCK_TARGET_A_TEMPLATE=assets/targets/adrenoreceptors/b1.yaml
DUALDOCK_TARGET_B_TEMPLATE=assets/targets/adrenoreceptors/b2.yaml
