{
  "hardware": {
    "name": "A6000",
    "cuda_visible_devices": "auto",
    "gpu_count": 6,
    "gpu_ids": "0,1,2,3,4,5",
    "gpu_lock_dir": "/tmp/dualdock_gpu_locks",
    "gpu_lock_wait_sec": 1800,
    "gpu_lock_poll_sec": 3.0,
    "profile": "A6000"
  },
  "rl": {
    "device": "cuda:0",
    "batch_size": 8,
    "learning_rate": 0.0001,
    "reward_strategy": "dap",
    "sigma": 128,
    "max_steps": 24,
    "min_steps": 8,
    "max_score": 0.95,
    "checkpoint_prefix": "dual_b1_vs_b2_agent",
    "checkpoint_every_steps": 12,
    "use_checkpoint": false,
    "purge_memories": false,
    "summary_csv_prefix": "dual_b1_vs_b2_staged_learning",
    "randomize_smiles": true,
    "unique_sequences": true,
    "tb_isim": false
  },
  "boltz": {
    "accelerator": "gpu",
    "devices": "1",
    "num_workers": 2,
    "recycling_steps": 1,
    "sampling_steps": 3,
    "diffusion_samples": 1,
    "sampling_steps_affinity": 3,
    "diffusion_samples_affinity": 1,
    "timeout_sec": 900,
    "model": "boltz2",
    "score_mode": "prob",
    "keep_tmp": false
  },
  "experiment": {
    "name": "dual_selective_b1_vs_b2_a6000",
    "description": "Server baseline: optimize b1 and penalize b2 for selectivity"
  },
  "docking": {
    "mode": "dual"
  },
  "executables": {
    "reinvent4_bin": "",
    "reinvent4_root": "",
    "boltz_bin": "",
    "boltz_root": "",
    "python_bin": ""
  },
  "paths": {
    "prior_file": "priors/reinvent.prior",
    "agent_file": "priors/reinvent.prior",
    "target_a_name": "b1",
    "target_b_name": "b2",
    "target_a_template": "assets/targets/adrenoreceptors/b1.yaml",
    "target_b_template": "assets/targets/adrenoreceptors/b2.yaml"
  },
  "optimizer": {
    "name": "adam"
  },
  "scoring": {
    "aggregation": "geometric_mean",
    "qed_weight": 0.2,
    "external_weight": 0.8,
    "external_property": "total_reward"
  },
  "selectivity": {
    "mode": "weighted_sum",
    "weight_a": 0.5,
    "weight_b": 0.5,
    "reward_shift": 0.0,
    "reward_clip_min": 0.0,
    "reward_clip_max": 1.0,
    "penalty": {
      "off_target_threshold": 0.7,
      "off_target_penalty": 0.2
    },
    "normalization": {
      "target_a": {
        "method": "sigmoid",
        "midpoint": 0.5,
        "slope": 8.0,
        "clip_min": 0.0,
        "clip_max": 1.0,
        "invert": false
      },
      "target_b": {
        "method": "sigmoid",
        "midpoint": 0.5,
        "slope": 8.0,
        "clip_min": 0.0,
        "clip_max": 1.0,
        "invert": false
      }
    }
  },
  "fallback": {
    "score": 0.05,
    "invalid_smiles_score": 0.0
  },
  "validation": {
    "require_rdkit": true
  },
  "output": {
    "root": "runs",
    "rank_by": "best_total_reward",
    "plots": true
  },
  "postprocess": {
    "enabled": false,
    "num_smiles": 1500,
    "max_sampled_smiles": 1500,
    "sample_strategy": "multinomial",
    "temperature": 1.0,
    "unique_molecules": true,
    "randomize_smiles": false,
    "score_batch_size": 16,
    "rank_by": "best_total_reward",
    "plots": true
  }
}