# Required executables (set one of each pair)
export REINVENT4_BIN="reinvent"
# export REINVENT4_ROOT="../REINVENT4"

export BOLTZ_BIN="boltz"
# export BOLTZ_ROOT="../boltz"

# Optional Python executable for wrappers/runner
export PYTHON="python"

# Optional assets root (repo-relative recommended)
export DUALDOCK_ASSETS_ROOT="assets"

# Optional target templates (repo-relative)
export DUALDOCK_TARGET_A_TEMPLATE="assets/targets/adrenoreceptors/b1.yaml"
export DUALDOCK_TARGET_B_TEMPLATE="assets/targets/adrenoreceptors/b2.yaml"
