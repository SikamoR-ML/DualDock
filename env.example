# Where target YAML templates live
export BOLTZ_TARGET_DIR="<PATH_TO_DualDock/assets/targets/adrenoreceptors>"

# Single wrapper config
export BOLTZ_SCORE_MODE="pred"        # pred|prob
export BOLTZ_TIMEOUT="900"
export BOLTZ_STEPS="10"
export BOLTZ_AFF_STEPS="10"
export BOLTZ_DEBUG="1"
export BOLTZ_BOLTZ_STDERR="1"
export BOLTZ_KEEP_TMP="0"

# Logging and tracing (repo-local)
export BOLTZ_LOG_DIR="<PATH_TO_DualDock/logs/boltz_wrapper>"
export BOLTZ_TRACE_JSONL="<PATH_TO_DualDock/results/traces/run_$(date +%Y%m%d_%H%M%S).jsonl"
export BOLTZ_RUN_ID="run_$(date +%Y%m%d_%H%M%S)"
export BOLTZ_META_JSON='{"note":"fill me"}'

# Dual wrapper config
export BOLTZ_TARGET_A="<TARGET_A_NAME>"
export BOLTZ_TARGET_B="<TARGET_B_NAME>"
export BOLTZ_LAMBDA="1.0"
export BOLTZ_DUAL_MODE="linear"       # linear|hinge
export BOLTZ_TAU="0.0"
